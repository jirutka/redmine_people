<div class="person-card">
  <div class="avatar"><%= link_to avatar(person_birthday, size: '32'), person_path(person_birthday), id: 'avatar' %></div>
  <div class="name">
    <h4><%= link_to person_birthday.name, person_path(person_birthday) %></h4>
    <p class="info" title="<%= format_date(person_birthday.birthday) %>"><%= birthday_date(person_birthday) %></p>
  </div>
</div>
